+def repaired_age(raw_data):
+    raw = pd.read_parquet(raw_data, columns=['origin', 'img_age_h'], filters=[('h', '==', 1)])
+    raw['origin'] = pd.to_datetime(raw.origin, utc=True)
+    if raw.groupby('origin').img_age_h.nunique(dropna=False).gt(1).any():
+        raise ValueError('Conflicting raw image ages at one origin')
+    raw = raw.drop_duplicates('origin').sort_values('origin').set_index('origin')
+    age = raw.img_age_h
+    if (age.dropna() < 0).any() or np.isinf(age).any():
+        raise ValueError('Raw image ages must be nonnegative or missing')
+    origin = pd.Series(raw.index, index=raw.index)
+    source_time = (origin - pd.to_timedelta(age, unit='h')).ffill()
+    # Leading missing observations remain missing. No backward fill or targets.
+    return (origin - source_time).dt.total_seconds() / 3600
+
+
+def repair_grid(grid, names, ages, *, training):
+    if 'img_age_h' not in names['constant']:
+        raise ValueError('Baseline must retain img_age_h')
+    if not grid['origins'].isin(ages.index).all():
+        raise ValueError('Raw image timeline does not cover every input origin')
+    col = names['constant'].index('img_age_h')
+    values = ages.reindex(grid['origins']).to_numpy(np.float32)
+    if np.isinf(values).any() or (values < 0).any() or (not training and np.isnan(values).any()):
+        raise ValueError('Invalid causal image age for input grid')
+    changed = dict(grid, C=grid['C'].copy())
+    changed['C'][:, col] = values
+    keep = [i for i in range(grid['C'].shape[1]) if i != col]
+    if not np.array_equal(grid['C'][:, keep], changed['C'][:, keep], equal_nan=True):
+        raise AssertionError('Non-age constant inputs changed')
+    if not np.array_equal(grid['E'], changed['E'], equal_nan=True):
+        raise AssertionError('Varying inputs changed')
+    equal = (values == grid['C'][:, col]) | (np.isnan(values) & np.isnan(grid['C'][:, col]))
+    finite = values[np.isfinite(values)]
+    receipt = {'training': training, 'origins': len(values), 'changed_column': 'img_age_h',
+                   'changed_origins': int((~equal).sum()), 'missing_age_origins': int(np.isnan(values).sum()),
+                   'max_repaired_age_h': float(finite.max()) if len(finite) else None,
+                   'unchanged_other_inputs': True, 'feature_count': sum(map(len, names.values()))}
+    return changed, receipt
+
+
+def bind_repaired_loader(baseline, ages, receipts):
+    original = baseline.load_grid
+
+    def load_grid(data, period, names, training):
+        grid, labels = original(data, period, names, training)
+        if not training and labels is not None:
+            raise ValueError('Query loader returned evaluation labels')
+        changed, receipt = repair_grid(grid, names, ages, training=training)
+        receipts.append(dict(period=period, **receipt))
+        return changed, labels
+
+    baseline.load_grid = load_grid
+
