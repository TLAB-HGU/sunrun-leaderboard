"""Transfer-gated HL-Gauss histogram study on the frozen feat30 extreme lane.

Owned study for campaign direction 2.  On identical windows, rows and seed it
refits (a) the frozen parent recipe ``extreme_4.0`` (block-weighted regression),
(b) the unweighted regression reference, and (c) one HL-Gauss histogram head run
in two forms -- unweighted, and weighted by a label-only fast-wind weight.  The
weighted head is read out twice, as learnt (``hist_weighted_raw``) and after the
exact target-shift posterior correction (``hist_weighted_corrected``); the two
share a single training run, so the correction costs no extra fit.

Everything is checkpointed per window and arm, and no setting is chosen from an
official score.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import sys
import time
import traceback

os.environ.setdefault('OMP_NUM_THREADS', '3')
os.environ.setdefault('OPENBLAS_NUM_THREADS', '1')
import numpy as np
import pandas as pd
import xgboost as xgb

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
CACHE = ROOT / 'analysis/forecast_strategies_e2000/outputs/cache'
PARENT = ROOT / 'analysis/e2000fs_dirmo_24_feat30/logs/full_01'
SHARED = ROOT / 'analysis/e2000fs_feat30_followups'

HORIZON = 72
BLOCK = 24
FAST = 550.
ROUNDS = 300
SEED = 42
SMOKE_ROUNDS = 3
FACTOR = 4.0

# origin windows, UTC, inclusive at both ends (PROTOCOL.md)
WINDOWS = {
    'D1': ('2024-12-04', '2025-02-22'),
    'D2': ('2025-03-04', '2025-05-22'),
    'D3': ('2025-09-04', '2025-11-22'),
    'C': ('2025-12-04', '2026-02-22'),
}
DEV = ('D1', 'D2', 'D3')
CUTOFF = {'f1': '2026-02-26', 'final': '2026-05-29'}
# arm -> (trained model key, inference read-out)
ARMS = {
    'parent': ('parent', None),
    'reference': ('reference', None),
    'hist_unweighted': ('hist_unweighted', None),
    'hist_weighted_raw': ('hist_weighted', None),
    'hist_weighted_corrected': ('hist_weighted', 'corrected'),
}
TRAINED = ('parent', 'reference', 'hist_unweighted', 'hist_weighted')


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def sanitize(value):
    """Convert numpy/json-hostile values into strict JSON, mapping NaN to null."""
    if isinstance(value, dict):
        return {str(k): sanitize(v) for k, v in value.items()}
    if isinstance(value, (list, tuple, np.ndarray)):
        items = value.tolist() if isinstance(value, np.ndarray) else list(value)
        return [sanitize(v) for v in items]
    if isinstance(value, np.generic):
        return sanitize(value.item())
    if isinstance(value, bool) or value is None or isinstance(value, (int, str)):
        return value
    if isinstance(value, float):
        return value if np.isfinite(value) else None
    if isinstance(value, (Path, pd.Timestamp)):
        return str(value)
    raise TypeError(type(value).__name__)


def write(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + '.tmp')
    temp.write_text(json.dumps(sanitize(value), indent=2, allow_nan=False) + '\n')
    temp.replace(path)


def save_array(path, **arrays):
    temp = Path(str(path) + '.tmp')
    with temp.open('wb') as handle:
        np.savez_compressed(handle, **arrays)
    temp.replace(path)


def log(directory, status, **extra):
    payload = dict(status=status, pid=os.getpid(),
                   utc=pd.Timestamp.now(tz='UTC').isoformat(), **extra)
    write(directory / 'status.json', payload)
    print(json.dumps(payload, default=str), flush=True)


# --------------------------------------------------------------------------- data

def load_data():
    """Load the frozen cache exactly as the parent lane does."""
    manifest = json.loads((PARENT / 'manifest.json').read_text())
    names = json.loads((CACHE / 'names.json').read_text())
    selected = manifest['selected']
    ci = [i for i, n in enumerate(names['constant']) if n in selected]
    ei = [i for i, n in enumerate(names['varying']) if n in selected]
    if len(ci) != 21 or len(ei) != 9 or len(set(selected)) != 30:
        raise RuntimeError('frozen feature selection changed')
    series = pd.read_parquet(CACHE / 'speed.parquet').speed
    data = {}
    for stage in ('train', 'f1', 'official'):
        with np.load(CACHE / f'{stage}.npz') as archive:
            origins = pd.to_datetime(archive['origins'], utc=True)
            stamps = origins.values[:, None] + np.arange(1, HORIZON + 1).astype('timedelta64[h]')
            y = series.reindex(pd.DatetimeIndex(stamps.ravel(), tz='UTC')).to_numpy()
            data[stage] = dict(origins=origins, C=archive['C'][:, ci], E=archive['E'][:, :, ei],
                               Y=np.asarray(y, dtype=np.float64).reshape(-1, HORIZON))
    return manifest, data


def design(bundle, block):
    """The parent's 237-column block design: 21 constants + 24h x 9 varying."""
    varying = bundle['E'][:, block * BLOCK:(block + 1) * BLOCK]
    return np.hstack([bundle['C'], varying.reshape(len(varying), -1)]).astype(np.float32)


def take(bundle, index):
    return {key: value[index] for key, value in bundle.items()}


def window_split(origins, name):
    """Fit rows need a fully mature 72h target strictly before the window start."""
    lower, upper = WINDOWS[name]
    start = pd.Timestamp(lower, tz='UTC')
    end = pd.Timestamp(upper, tz='UTC') + pd.Timedelta(hours=23)
    boundary = np.datetime64(start.tz_convert('UTC').tz_localize(None))
    mature = origins.values + np.timedelta64(HORIZON, 'h')
    fit = np.flatnonzero(mature < boundary)
    evaluate = np.flatnonzero((origins >= start) & (origins <= end))
    if not len(fit) or not len(evaluate):
        raise RuntimeError(f'empty split for window {name}')
    if not (mature[fit] < boundary).all():
        raise RuntimeError('immature training row leaked into the fit set')
    if origins[fit].max() + pd.Timedelta(hours=HORIZON) >= origins[evaluate].min():
        raise RuntimeError('fit set is not strictly before the evaluation window')
    return fit, evaluate


def cutoff_split(origins, stage):
    """The parent's F1/final training cutoffs."""
    boundary = pd.Timestamp(CUTOFF[stage], tz='UTC')
    fit = np.flatnonzero(origins + pd.Timedelta(hours=HORIZON) < boundary)
    if not len(fit) or (origins[fit] + pd.Timedelta(hours=HORIZON) >= boundary).any():
        raise RuntimeError('immature row leaked into the cutoff fit set')
    return fit


# --------------------------------------------------------------------- baselines

def parent_params(y, rounds=ROUNDS):
    params = dict(json.loads((PARENT / 'manifest.json').read_text())['params'])
    params.update(n_estimators=rounds, base_score=float(np.mean(y)), eval_metric='rmse',
                  n_jobs=3, random_state=SEED, tree_method='hist', device='cpu',
                  multi_strategy='multi_output_tree', objective='reg:squarederror')
    return params


def fit_regression(X, Y, fit, evaluate, weighted, rounds=ROUNDS):
    """The parent's multi-output regression head, weighted or unweighted."""
    sys.path.insert(0, str(SHARED))
    try:
        import methods
        weights = methods.extreme_weights(Y[fit], FACTOR) if weighted else None
    finally:
        sys.path.remove(str(SHARED))
        sys.modules.pop('methods', None)
    model = xgb.XGBRegressor(**parent_params(Y[fit], rounds))
    model.fit(X[fit], Y[fit], sample_weight=weights,
              eval_set=[(X[fit], Y[fit]), (X[evaluate], Y[evaluate])], verbose=False)
    history = model.evals_result()
    curve = dict(train_mse=np.square(history['validation_0']['rmse']),
                 valid_mse=np.square(history['validation_1']['rmse']))
    return model, curve


def predict_regression(models, bundle, block, index):
    return models[block].predict(design(bundle, block)[index])


# --------------------------------------------------------------------- histogram

def hist_params():
    """Parent hyper-parameters with the two Hessian-scale-dependent penalties converted.

    A K-class softmax Hessian p(1-p) is about 1/K of the squared-error Hessian, so
    reg_lambda and min_child_weight are multiplied by the a-priori constant
    h_ref = (1/K)(1-1/K).  Without the conversion the same numbers would impose
    ~17x stronger effective shrinkage on the histogram head than on the parent;
    the conversion keeps regularisation equal and changes no structural setting.
    """
    import hist
    k = len(hist.EDGES) - 1
    h_ref = (1. / k) * (1. - 1. / k)
    params = dict(objective='multi:softprob', num_class=k, max_depth=3, learning_rate=0.03,
                  subsample=0.8, colsample_bytree=0.7, min_child_weight=20. * h_ref,
                  reg_lambda=5. * h_ref, nthread=3, seed=SEED, tree_method='hist',
                  device='cpu', base_score=0.0, disable_default_eval_metric=1)
    return params, h_ref


def histogram_curves(history, rounds):
    out = {}
    for split in ('train', 'valid'):
        for name, tag in (('ce', 'ce'), ('rmse_kms', 'rmse')):
            values = np.asarray(history[split][name], dtype=np.float64)
            if len(values) != rounds:
                raise RuntimeError('loss history length mismatch')
            out[f'{split}_{tag}'] = values
    return out


def fit_histogram(folder, X, Y, fit, evaluate, factor, rounds, verbose=False):
    """One K-class histogram head per horizon of one 24h block.

    Returns raw and corrected point forecasts for the evaluation rows plus the
    per-round loss history, and writes one booster per horizon.
    """
    import hist
    folder.mkdir(parents=True, exist_ok=True)
    params, _ = hist_params()
    registry = hist.LabelRegistry()
    reps = hist.representatives(Y[fit].ravel())
    binw = hist.bin_weight(factor)
    k = len(hist.EDGES) - 1
    dvalid = xgb.DMatrix(X[evaluate], nthread=3)
    n_eval = len(evaluate)
    raw = np.empty((n_eval, BLOCK))
    corrected = np.empty((n_eval, BLOCK))
    curves = {key: np.empty((BLOCK, rounds)) for key in
              ('train_ce', 'valid_ce', 'train_rmse', 'valid_rmse')}
    reload_delta = 0.
    for h in range(BLOCK):
        target = Y[:, h]
        q_fit = hist.soft_labels(target[fit])
        q_valid = hist.soft_labels(target[evaluate])
        weight = hist.point_weights(target[fit], factor)
        dtrain = registry.add(xgb.DMatrix(X[fit], label=np.arange(len(fit), dtype=np.float32),
                                          nthread=3), q_fit, weight)
        dval = registry.add(xgb.DMatrix(X[evaluate], label=np.arange(n_eval, dtype=np.float32),
                                        nthread=3), q_valid)

        def metric(pred, dmat, registry=registry, reps=reps):
            truth, _ = registry(dmat)
            expected = hist.softmax(pred) @ reps
            return [('ce', hist.soft_cross_entropy(truth, pred)),
                    ('rmse_kms', float(np.sqrt(np.mean((expected - truth @ reps) ** 2))))]

        history = {}
        booster = xgb.train(params, dtrain, num_boost_round=rounds,
                            obj=hist.class_objective(registry), custom_metric=metric,
                            evals=[(dtrain, 'train'), (dval, 'valid')],
                            evals_result=history, verbose_eval=False)
        for key, values in histogram_curves(history, rounds).items():
            curves[key][h] = values
        path = folder / f'h{h:02}.ubj'
        booster.save_model(path)
        reloaded = xgb.Booster(model_file=str(path))
        reloaded.set_param({'nthread': 3})
        margin = booster.predict(dvalid, output_margin=True)
        again = reloaded.predict(dvalid, output_margin=True)
        if margin.shape != (n_eval, k):
            raise RuntimeError(f'unexpected margin shape {margin.shape}')
        np.testing.assert_allclose(margin, again, rtol=0, atol=1e-6)
        reload_delta = max(reload_delta, float(np.max(np.abs(margin - again))))
        raw[:, h], _ = hist.histogram_mean(margin, reps)
        corrected[:, h], _ = hist.histogram_mean(margin, reps, binw)
        if verbose:
            print(json.dumps(dict(horizon=h + 1, train_ce=float(curves['train_ce'][h, -1]),
                                  valid_ce=float(curves['valid_ce'][h, -1]),
                                  train_rmse=float(curves['train_rmse'][h, -1]))), flush=True)
    return dict(raw=raw, corrected=corrected, curves=curves, representatives=reps,
                reload_max_abs_delta=reload_delta, bin_weights=binw)


# ----------------------------------------------------------------------- metrics

def band_metrics(truth, pred):
    """Conditional MSEs under the official 550 km/s split, plus diagnostics."""
    truth = np.asarray(truth, dtype=np.float64)
    pred = np.asarray(pred, dtype=np.float64)
    if truth.shape != pred.shape or truth.ndim != 2 or truth.shape[1] != HORIZON:
        raise ValueError('truth and predictions must share an (n, 72) shape')
    if not np.isfinite(truth).all() or not np.isfinite(pred).all():
        raise ValueError('truth and predictions must be finite')
    error = pred - truth
    low, high = truth < FAST, truth >= FAST
    if not low.any() or not high.any():
        raise ValueError('a band is empty; the split is not comparable')
    peak_truth, peak_pred = truth.max(axis=1), pred.max(axis=1)
    ramp_truth = np.maximum(0., (truth[:, 6:] - truth[:, :-6]).max(axis=1))
    ramp_pred = np.maximum(0., (pred[:, 6:] - pred[:, :-6]).max(axis=1))
    return dict(
        n_origins=int(len(truth)), n_pairs=int(truth.size),
        mse=float(np.mean(error ** 2)), mae=float(np.mean(np.abs(error))),
        mse_lt550=float(np.mean(error[low] ** 2)), mse_ge550=float(np.mean(error[high] ** 2)),
        bias_ge550=float(np.mean(error[high])), bias_lt550=float(np.mean(error[low])),
        n_pairs_lt550=int(low.sum()), n_pairs_ge550=int(high.sum()),
        peak_mae=float(np.mean(np.abs(peak_pred - peak_truth))),
        peak_bias=float(np.mean(peak_pred - peak_truth)),
        ramp6_mae=float(np.mean(np.abs(ramp_pred - ramp_truth))),
    )


def reweighted(metrics, p):
    return (1. - p) * metrics['mse_lt550'] + p * metrics['mse_ge550']


def window_p_train(Y, fit):
    return float((np.asarray(Y[fit]) >= FAST).mean())


def load_prediction(directory, window, arm):
    """Predictions of an arm, picking the read-out that arm reports."""
    trained, readout = ARMS[arm]
    path = directory / 'windows' / window / trained / 'predictions.npz'
    if not path.is_file():
        return None, None
    with np.load(path) as archive:
        index = archive['indices']
        if trained in ('parent', 'reference'):
            return archive['pred'], index
        return archive['corrected' if readout == 'corrected' else 'raw'], index


# ------------------------------------------------------------------------ runner

def snapshot(smoke):
    parent = json.loads((PARENT / 'manifest.json').read_text())
    for path, expected in parent['hashes'].items():
        if not Path(path).is_file() or digest(path) != expected:
            raise RuntimeError(f'frozen parent input changed or missing: {path}')
    paths = [*sorted(HERE.glob('*.py')), *sorted(SHARED.glob('*.py')),
             PARENT / 'manifest.json', CACHE / 'names.json', CACHE / 'speed.parquet',
             CACHE / 'receipt.json', *sorted(CACHE.glob('*.npz'))]
    content = {str(p): digest(p) for p in paths}
    identity = hashlib.sha256(json.dumps(
        dict(hashes=content, smoke=smoke, threads=3, rounds=SMOKE_ROUNDS if smoke else ROUNDS,
             protocol='histprior-v1'), sort_keys=True).encode()).hexdigest()
    import hist
    return dict(identity=identity, hashes=content, smoke=smoke, threads=3,
                rounds=SMOKE_ROUNDS if smoke else ROUNDS, seed=SEED,
                test_band=FAST, bins=[float(v) for v in hist.EDGES],
                fast_bin=int(hist.FAST_BIN), pointwise_factor=FACTOR,
                source='frozen feat30 cache; post-hoc, official-exposed; not a fresh holdout',
                windows=WINDOWS, arms=list(ARMS), parent=str(PARENT),
                target='absolute filled ACE speed km/s; no additive correction',
                xgboost=xgb.__version__, python=sys.version)


def ensure_identity(directory, manifest):
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / 'manifest.json'
    if path.exists():
        prior = json.loads(path.read_text())
        if prior != manifest:
            raise RuntimeError(f'refusing incompatible resume: {directory}')
    else:
        write(path, manifest)


def completed(receipt, identity):
    return receipt.exists() and json.loads(receipt.read_text()).get('identity') == identity


def run_regression_arm(directory, window, arm, data, manifest, smoke):
    rounds = manifest['rounds']
    fit, evaluate = window_split(data['train']['origins'], window)
    if smoke:
        fit = fit[np.linspace(0, len(fit) - 1, min(128, len(fit))).astype(int)]
        evaluate = evaluate[np.linspace(0, len(evaluate) - 1, min(32, len(evaluate))).astype(int)]
    receipt = directory / 'receipt.json'
    if completed(receipt, manifest['identity']):
        print(f'{window}/{arm}: cached', flush=True)
        return
    folder = directory / 'models'
    folder.mkdir(parents=True, exist_ok=True)
    pred = np.empty((len(evaluate), HORIZON))
    curves = {}
    bundle = data['train']
    for block in range(3):
        X = design(bundle, block)
        Y = bundle['Y'][:, block * BLOCK:(block + 1) * BLOCK]
        model, curve = fit_regression(X, Y, fit, evaluate, weighted=arm == 'parent', rounds=rounds)
        curves[f'b{block:02}'] = curve
        pred[:, block * BLOCK:(block + 1) * BLOCK] = model.predict(X[evaluate])
        path = folder / f'b{block:02}.ubj'
        model.get_booster().save_model(path)
        reloaded = xgb.Booster(model_file=str(path))
        np.testing.assert_allclose(model.predict(X[evaluate]),
                                   reloaded.predict(xgb.DMatrix(X[evaluate], nthread=3)),
                                   rtol=0, atol=1e-5)
        steps = len(curve['train_mse'])
        pd.DataFrame(dict(round=np.arange(1, steps + 1), train_mse=curve['train_mse'],
                          diagnostic_validation_mse=curve['valid_mse'])
                     ).to_csv(folder / f'b{block:02}_loss.csv', index=False)
    pred = np.clip(pred, 1., 3000.)
    save_array(directory / 'predictions.npz', pred=pred, origins=bundle['origins'][evaluate].asi8,
               indices=evaluate)
    write(receipt, dict(identity=manifest['identity'], window=window, arm=arm, rounds=rounds,
                        fit_rows=int(len(fit)), eval_rows=int(len(evaluate)),
                        weighted=arm == 'parent', models=3, complete=True))


def run_hist_arm(directory, window, arm, data, manifest, smoke):
    rounds = manifest['rounds']
    fit, evaluate = window_split(data['train']['origins'], window)
    if smoke:
        fit = fit[np.linspace(0, len(fit) - 1, min(128, len(fit))).astype(int)]
        evaluate = evaluate[np.linspace(0, len(evaluate) - 1, min(32, len(evaluate))).astype(int)]
    receipt = directory / 'receipt.json'
    if completed(receipt, manifest['identity']):
        print(f'{window}/{arm}: cached', flush=True)
        return
    factor = FACTOR if arm == 'hist_weighted' else 1.0
    bundle = data['train']
    raw = np.empty((len(evaluate), HORIZON))
    corrected = np.empty((len(evaluate), HORIZON))
    curves, extras = {}, {}
    start = time.time()
    for block in range(3):
        folder = directory / 'models' / f'b{block:02}'
        folder.mkdir(parents=True, exist_ok=True)
        X = design(bundle, block)
        Y = bundle['Y'][:, block * BLOCK:(block + 1) * BLOCK]
        result = fit_histogram(folder, X, Y, fit, evaluate, factor, rounds)
        raw[:, block * BLOCK:(block + 1) * BLOCK] = result['raw']
        corrected[:, block * BLOCK:(block + 1) * BLOCK] = result['corrected']
        for key, values in result['curves'].items():
            curves[f'b{block:02}_{key}'] = values
        extras[f'b{block:02}'] = dict(reload_max_abs_delta=result['reload_max_abs_delta'],
                                      representatives=result['representatives'],
                                      bin_weights=result['bin_weights'])
        log(directory, 'running', phase=f'{window}/{arm}', block=block,
            elapsed_s=round(time.time() - start, 1))
    save_array(directory / 'loss.npz', **curves)
    save_array(directory / 'predictions.npz', raw=np.clip(raw, 1., 3000.),
               corrected=np.clip(corrected, 1., 3000.),
               origins=bundle['origins'][evaluate].asi8, indices=evaluate)
    write(receipt, dict(identity=manifest['identity'], window=window, arm=arm, rounds=rounds,
                        fit_rows=int(len(fit)), eval_rows=int(len(evaluate)), factor=factor,
                        models=3 * BLOCK, complete=True,
                        reload_parity_max_abs={k: v['reload_max_abs_delta'] for k, v in extras.items()},
                        representatives={k: v['representatives'] for k, v in extras.items()},
                        bin_weights={k: v['bin_weights'] for k, v in extras.items()}))


def parent_parity(data):
    """Reproduce the frozen parent's saved predictions from my own data path."""
    evidence = {}
    for stage, grid in (('f1', 'f1'), ('final', 'official')):
        models = [xgb.Booster(model_file=str(PARENT / 'artifacts' / f'{stage}_b{b:02}.ubj'))
                  for b in range(3)]
        for model in models:
            model.set_param({'nthread': 3})
        bundle = data[grid]
        pred = np.clip(np.hstack([models[b].predict(xgb.DMatrix(design(bundle, b), nthread=3))
                                  for b in range(3)]), 1., 3000.)
        saved = np.load(PARENT / 'artifacts' / f'{stage}_predictions.npy')
        np.testing.assert_array_equal(pred, saved)
        evidence[stage] = dict(origins=int(len(pred)), max_abs_diff=0.)
    return evidence


def aggregate(directory, data, manifest):
    rows = []
    for window in WINDOWS:
        fit, _ = window_split(data['train']['origins'], window)
        p = window_p_train(data['train']['Y'], fit)
        for arm in ARMS:
            pred, index = load_prediction(directory, window, arm)
            if pred is None:
                continue
            truth = data['train']['Y'][index]
            metrics = band_metrics(truth, pred)
            rows.append(dict(window=window, arm=arm, p_train=p, rounds=manifest['rounds'],
                             mse_rw=reweighted(metrics, p), **metrics))
    frame = pd.DataFrame(rows)
    if frame.empty:
        write(directory / 'aggregate.json', dict(rows=[], pooled={}, gates={}))
        return frame, {}
    frame.to_csv(directory / 'windows.csv', index=False)
    # pooled D1-D3 with a pair-weighted training prevalence
    pooled = {}
    for arm in ARMS:
        truth, pred, p, sizes = [], [], [], []
        for window in DEV:
            block, index = load_prediction(directory, window, arm)
            if block is None:
                break
            pred.append(block)
            truth.append(data['train']['Y'][index])
            sizes.append(len(index))
            fit, _ = window_split(data['train']['origins'], window)
            p.append(window_p_train(data['train']['Y'], fit))
        if len(pred) != len(DEV):
            continue
        truth = np.vstack(truth)
        pred = np.vstack(pred)
        p_pooled = float(np.average(p, weights=np.asarray(sizes, dtype=float)))
        metrics = band_metrics(truth, pred)
        pooled[arm] = dict(window='D1-D3', arm=arm, p_train=p_pooled, rounds=manifest['rounds'],
                           mse_rw=reweighted(metrics, p_pooled), **metrics)
    if pooled:
        frame = pd.concat([frame, pd.DataFrame(list(pooled.values()))], ignore_index=True)
        frame.to_csv(directory / 'windows.csv', index=False)
    gates = gate_report(frame)
    write(directory / 'aggregate.json', dict(rows=rows, pooled=pooled, gates=gates))
    return frame, gates


def gate_report(frame):
    """The PROTOCOL.md internal gate, evaluated on what actually finished."""
    out = {}
    parent = frame[(frame.arm == 'parent') & (frame.window.isin(DEV))]
    reference = frame[(frame.arm == 'reference') & (frame.window.isin(DEV))]
    parent_pool = frame[(frame.arm == 'parent') & (frame.window == 'D1-D3')]
    reference_pool = frame[(frame.arm == 'reference') & (frame.window == 'D1-D3')]
    if not len(parent_pool) or not len(reference_pool):
        return out
    base_rw = float(parent_pool.mse_rw.iloc[0])
    base_ge = float(parent_pool.mse_ge550.iloc[0])
    reference_ge = float(reference_pool.mse_ge550.iloc[0])
    for arm in ARMS:
        pool = frame[(frame.arm == arm) & (frame.window == 'D1-D3')]
        if not len(pool):
            continue
        row = pool.iloc[0]
        per_window = frame[(frame.arm == arm) & (frame.window.isin(DEV))].set_index('window')
        base_window = parent.set_index('window')
        improved = int(sum(per_window.loc[w, 'mse_rw'] < base_window.loc[w, 'mse_rw']
                           for w in DEV if w in per_window.index and w in base_window.index))
        check = frame[(frame.arm == arm) & (frame.window == 'C')]
        out[arm] = dict(
            pooled_mse_rw=float(row.mse_rw), parent_pooled_mse_rw=base_rw,
            delta_rw_percent=100. * (float(row.mse_rw) / base_rw - 1.),
            pooled_mse_ge550=float(row.mse_ge550), parent_pooled_mse_ge550=base_ge,
            reference_pooled_mse_ge550=reference_ge,
            delta_ge550_vs_reference_percent=100. * (float(row.mse_ge550) / reference_ge - 1.),
            windows_improved=improved,
            gate1=bool(float(row.mse_rw) <= 0.99 * base_rw and improved >= 2),
            gate2=bool(float(row.mse_ge550) <= 0.95 * reference_ge),
            confirmation_window_C=bool(len(check) and
                                       float(check.mse_rw.iloc[0]) <= 0.99 * float(
                                           frame[(frame.arm == 'parent') & (frame.window == 'C')].mse_rw.iloc[0])
                                       and float(check.mse_ge550.iloc[0]) <= 0.95 * float(
                                           frame[(frame.arm == 'reference') & (frame.window == 'C')].mse_ge550.iloc[0])),
        )
    return out


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run-id', required=True)
    parser.add_argument('--windows', default=','.join(WINDOWS))
    parser.add_argument('--arms', default=','.join(TRAINED))
    parser.add_argument('--smoke', action='store_true')
    parser.add_argument('--skip-parity', action='store_true')
    args = parser.parse_args()
    if Path(args.run_id).name != args.run_id:
        parser.error('run-id must be a directory name')
    windows = [w.strip() for w in args.windows.split(',') if w.strip()]
    arms = [a.strip() for a in args.arms.split(',') if a.strip()]
    if set(windows) - set(WINDOWS):
        parser.error(f'unknown window in {windows}')
    if set(arms) - set(TRAINED):
        parser.error(f'unknown arm in {arms}')
    directory = HERE / 'runs' / args.run_id
    manifest = snapshot(args.smoke)
    ensure_identity(directory, manifest)
    log(directory, 'running', phase='start', windows=windows, arms=arms)
    try:
        _, data = load_data()
        if not args.skip_parity:
            write(directory / 'parent_parity.json', parent_parity(data))
            log(directory, 'running', phase='parity_ok')
        for window in windows:
            for arm in arms:
                log(directory, 'running', phase=f'{window}/{arm}')
                target = directory / 'windows' / window / arm
                target.mkdir(parents=True, exist_ok=True)
                if arm in ('parent', 'reference'):
                    run_regression_arm(target, window, arm, data, manifest, args.smoke)
                else:
                    run_hist_arm(target, window, arm, data, manifest, args.smoke)
                log(directory, 'running', phase=f'{window}/{arm}/done')
        frame, gates = aggregate(directory, data, manifest)
        log(directory, 'completed', windows=windows, arms=arms, gates=gates,
            table=frame.to_dict('records'))
    except BaseException as exc:
        traceback.print_exc()
        log(directory, 'failed', error=str(exc), exit_code=1)
        raise


if __name__ == '__main__':
    main()
