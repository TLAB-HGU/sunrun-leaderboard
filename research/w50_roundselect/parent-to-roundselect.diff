+EXPECTED_STOPPING = {'F1': 1706, 'F2': 1682, 'F3': 1730}
+ROUNDS = 900
+
+
+def first_minimum(curve, budget):
+    values = np.asarray(curve, dtype=np.float64)
+    if values.shape != (budget,) or not np.isfinite(values).all():
+        raise ValueError('Incomplete or nonfinite native RMSE curve')
+    return int(np.argmin(values)) + 1
+
+
+def fitting_subsets(baseline, origins, period):
+    reference, calibration, boundary = baseline.prior_split(origins)
+    if len(calibration) < 336:
+        raise ValueError('Insufficient original offset rows')
+    offset = calibration[-336:]
+    stopping = calibration[origins[calibration] + pd.Timedelta(hours=144) <= origins[offset[0]]]
+    if len(stopping) != EXPECTED_STOPPING[period]:
+        raise ValueError(f'{period}: stopping count {len(stopping)} != {EXPECTED_STOPPING[period]}')
+    return reference, calibration, stopping, offset, boundary
+
+
+def train_head(core, x, y, config, threads, rounds, stopping=None):
+    matrix = xgb.DMatrix(x, label=y.astype(np.float32), nthread=threads)
+    params = dict(core.baseline.PARAMS, seed=config['seed'], device='cpu',
+                  nthread=threads, num_target=24, base_score=float(y.mean()))
+    history = {}
+    evals = []
+    if stopping is not None:
+        xs, ys = stopping
+        evals = [(xgb.DMatrix(xs, label=ys.astype(np.float32), nthread=threads), 'stopping')]
+    model = xgb.train(params, matrix, num_boost_round=rounds,
+                      obj=core.make_objective(y, config), evals=evals,
+                      evals_result=history, verbose_eval=False)
+    if model.num_boosted_rounds() != rounds:
+        raise ValueError('Fresh model did not retain its complete requested tree budget')
+    return model, history.get('stopping', {}).get('rmse', []), params
+
+
+def check_control(raw, truth, origins, path):
+    with np.load(path) as frozen:
+        if not np.array_equal(origins, frozen['origins']):
+            raise ValueError('Control calibration origins differ from frozen parent')
+        if not np.array_equal(truth, frozen['training_truth']):
+            raise ValueError('Control training targets differ from frozen parent')
+        if raw.shape != frozen['raw'].shape or not np.isfinite(raw).all():
+            raise ValueError('Control calibration prediction shape or finiteness differs')
+        difference = float(np.max(np.abs(raw - frozen['raw'])))
+    if not np.isfinite(difference) or difference > 1e-6:
+        raise ValueError(f'Control prior900 mismatch: maximum absolute difference {difference} > 1e-6')
+    return {'passed': True, 'max_absolute_difference': difference, 'tolerance': 1e-6,
+            'frozen_reference': str(path)}
+
+
+def origin_range(origins, indices):
+    return {'rows': len(indices), 'start': str(origins[indices].min()),
+            'end': str(origins[indices].max())}
+
+
+def run_period(core, config, data, out, period, threads, identity):
