+    parser.add_argument('--observations', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--device', choices=('cpu',), required=True)
+    parser.add_argument('--threads', type=int, choices=(4,), required=True)
+    args = parser.parse_args(argv)
+    if args.experiment != f'roundselect_s{args.seed}':
+        parser.error('experiment must be roundselect_s followed by the selected seed')
