+           .set_index("t"))
+    valid = raw["status"].eq(0) & np.isfinite(raw["spd"]) & raw["spd"].gt(0)
+    obs = pd.DataFrame({"timestamp_utc": raw.index, "speed_kms": raw["spd"].where(valid).to_numpy()})
