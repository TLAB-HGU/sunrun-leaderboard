# Minimal ignore set: keep the working tree tiny so change-set capture is fast.
# Everything heavy (venvs, caches, parquet stores, model artifacts) is excluded by
# blocking all directories first, then un-ignoring only what ultragoal needs to see.
# NOTE: directories are excluded wholesale; the un-ignore block at the end lists
# what is tracked from leaderboard/, which is part of this repository.
/*
!/.gitignore
!/AGENTS.md
!/docs/
!/research
/research/*
# research/{leaderboard experiment}/: experiment.py (the only script), README.md,
# results/ (predictions and scores) and logs/ (*.jsonl) are tracked; weights/ stays local.
!/research/*/
/research/*/*
!/research/*/experiment.py
!/research/*/README.md
!/research/*/results/
!/research/*/logs/
/research/*/weights/
/research/**/__pycache__/

# Submitted experiment catalog and maintenance code; artifacts remain local.
!/experiments/
/experiments/**
!/experiments/*/
!/experiments/README.md
!/experiments/AGENTS.md
!/experiments/*/README.md
!/experiments/*/manifest.json
/experiments/_migration/*
!/experiments/_tools/*.py
!/experiments/_migration/CLEANUP_PLAN.md
!/experiments/_migration/REPORT.md
/experiments/_shared/

# leaderboard/ is part of this repository (subtree merge bfd7c9cc2, 2026-10-30;
# history archived at store/sunrun-single-repo-20261030.bundle). Code, tests,
# release scripts and receipts are tracked; published-site snapshots, release
# artifacts, experiment outputs, tool datasets and caches stay local.
!/leaderboard/
/leaderboard/experiments/
/leaderboard/.gjc/
/leaderboard/**/docs/
/leaderboard/**/releases/
/leaderboard/**/__pycache__/
/leaderboard/**/.pytest_cache/
/leaderboard/**/.venv
/leaderboard/**/.venv-fusion
/leaderboard/lb-maint/data/*.parquet
/leaderboard/lb-maint/data/*.csv
/leaderboard/lb-maint/data/raw/

# data-v2 source, configs and manifests are tracked; every data store, download
# tree and cache stays local (all databases live under data-v2/, user
# instruction 2026-10-30).
!/data-v2/
/data-v2/raw/
/data-v2/processed/
/data-v2/bundles/
/data-v2/input/
/data-v2/metric/
/data-v2/backups/
/data-v2/suvi/
/data-v2/collectors/
/data-v2/logs/
/data-v2/**/__pycache__/
/data-v2/**/.pytest_cache/
/data-v2/**/*.duckdb
/data-v2/**/*.parquet
/data-v2/**/*.nc
/data-v2/**/*.bak-*
/data-v2/**/*.done
/data-v2/**/logs/
/data-v2/**/*.log

/docs/**/__pycache__/

# Metric reference notebook and its specification (data/cache paths stay ignored).
!/metric
/metric/*
!/metric/metric.ipynb
!/onboarding.md

# Audit-first S50 study: preserve reviewable source and compact evidence.
!/analysis/
/analysis/*
!/analysis/w50_audit_20261108/
/analysis/w50_audit_20261108/*
!/analysis/w50_audit_20261108/*.py
!/analysis/w50_audit_20261108/*.md
!/analysis/w50_audit_20261108/*.json
!/analysis/w50_audit_20261108/*.csv

# Current published offset-roll diagnostic: source and fixed-sample evidence.
!/analysis/current_offset_roll_20261109/
/analysis/current_offset_roll_20261109/*
!/analysis/current_offset_roll_20261109/*.py
!/analysis/current_offset_roll_20261109/*.md
!/analysis/current_offset_roll_20261109/*.json
!/analysis/current_offset_roll_20261109/*.csv
!/analysis/current_offset_roll_20261109/*.html

!/analysis/current_offset_roll_direct_s_20261109/
/analysis/current_offset_roll_direct_s_20261109/*
!/analysis/current_offset_roll_direct_s_20261109/*.md
!/analysis/current_offset_roll_direct_s_20261109/*.json

# NumPy arrays are never tracked (2026-11-10)
*.npy
*.npz
